APP_NAME=Venatomar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://[DOMAINE]

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL 8 (Hostinger: hPanel > Bases de données MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=[NOM_BASE]
DB_USERNAME=[UTILISATEUR_BASE]
DB_PASSWORD=[MOT_DE_PASSE_BASE]

# Session cookie = "venatomar_session" (derived from APP_NAME). Its lifetime is
# shown in the cookie policy: keep both in sync.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# E-mails are queued in the database and sent by the scheduler (cron).
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Hostinger SMTP. MAIL_FROM_ADDRESS MUST equal MAIL_USERNAME (otherwise rejected).
# Fallback: MAIL_PORT=587 with MAIL_SCHEME=smtp (STARTTLS).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=[ADRESSE_EXPEDITEUR]
MAIL_PASSWORD=[MOT_DE_PASSE_BOITE]
MAIL_FROM_ADDRESS=[ADRESSE_EXPEDITEUR]
MAIL_FROM_NAME="Venatomar"

# Business
VENATOMAR_LEAD_RECIPIENT=info@venatomar.com
VENATOMAR_CONTACT_EMAIL=info@venatomar.com
VENATOMAR_COMPANY_NAME="Leads for Finance S.L.U"
VENATOMAR_LEGAL_FORM="S.L.U"
VENATOMAR_TAX_ID="B67406025"
VENATOMAR_TRADE_REGISTER="tome 46865, folio 53, feuille B533516"
VENATOMAR_ADDRESS="Carrer d’Estruc, 9, 08002 Barcelone"
VENATOMAR_CREDIT_INTERMEDIARY_NUMBER="B12345678"

# Third-party tags: loaded ONLY after cookie consent. Leave empty to disable.
VENATOMAR_GA4_ID=
VENATOMAR_GADS_ID=
VENATOMAR_META_PIXEL_ID=

VITE_APP_NAME="${APP_NAME}"

# Back-office (/admin): php artisan db:seed --class=AdminUserSeeder
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CONTACT_EMAIL=
ADMIN_CONTACT_PASSWORD=
ADMIN_AYUDA_EMAIL=
ADMIN_AYUDA_PASSWORD=
